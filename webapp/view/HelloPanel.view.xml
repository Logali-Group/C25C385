<mvc:View
            controllerName="com.logaligroup.invoices.controller.HelloPanel"
            xmlns="sap.m"
            xmlns:mvc="sap.ui.core.mvc">

    <Panel headerText="{i18n>helloPanel}"
            class="sapUiResponsiveMargin"
            width="auto">
        <content>
            <Button text="{i18n>helloDialogBut}"
                        class="sapUiSmallMarginEnd"
                        press="onOpenDialog"/>
            <Button class="sapUiSmallMarginEnd"
                    text="{i18n>showHelloButtonText}"
                    press="onShowMessage"/>
            <Input class="sapUiSmallMarginEnd"
                    value="{view>/recipient/name}"
                    width="60%"/>
            <Text text="Hello {view>/recipient/name}"
                    class="boldElements"/>
        </content>
    </Panel>

</mvc:View>