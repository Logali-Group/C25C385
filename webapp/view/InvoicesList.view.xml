<mvc:View
        controllerName="com.logaligroup.invoices.controller.InvoicesList"
        xmlns="sap.m"
        xmlns:core="sap.ui.core"
        xmlns:mvc="sap.ui.core.mvc">

        <List
                id="List"
                headerText="{i18n>invoices}"
                class="sapUiResponsiveMargin"
                items="{
                    path: 'invoices>/Invoices',
                    filters: {
                        path: 'ExtendedPrice',
                        operator: 'BT',
                        value1: '0.00',
                        value2: '500.00'
                    },
                    sorter: {
                        path: 'ShipperName',
                        group: true
                    }
                }"
                width="auto">

            <headerToolbar>
                <Toolbar>
                    <Title text="{i18n>invoices}"/>
                    <ToolbarSpacer/>
                    <SearchField search="onSearchPress"
                                    width="50%"/>
                </Toolbar>
            </headerToolbar>

            <items>
                <ObjectListItem 
                            title="{invoices>Quantity} x {invoices>ProductName}"
                            number="{
                                parts: [
                                    'invoices>ExtendedPrice',
                                    'currency>/usd'
                                ],
                                type: 'sap.ui.model.type.Currency',
                                formatOptions: {
                                    showMeasure: false
                                }
                            }"
                            numberUnit="{currency>/usd}"
                            numberState="{=
                                ( ${invoices>ExtendedPrice} >= 0.00 &amp;&amp; ${invoices>ExtendedPrice} &lt;= 50.00)? 'Error' : 
                                ( ${invoices>ExtendedPrice} > 50.00 &amp;&amp; ${invoices>ExtendedPrice} &lt;= 300.00)? 'Warning' :
                                ( ${invoices>ExtendedPrice} > 300.00 &amp;&amp; ${invoices>ExtendedPrice} &lt;= 700.00)? 'Success' : 'Information'
                            }">

                        <firstStatus>
                            <ObjectStatus 
                                    core:require="{
                                        MyFormmatter: 'com/logaligroup/invoices/model/formatter'
                                    }"
                                    text="{
                                        path:'invoices>Status',
                                        formatter: 'MyFormmatter.statusText.bind($controller)'
                                    }"/>
                        </firstStatus>

                    </ObjectListItem>
            </items>

        </List>


</mvc:View>